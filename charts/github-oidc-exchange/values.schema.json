{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "github-oidc-exchange chart values",
  "description": "Values for a fail-closed GitHub and Kubernetes workload OIDC exchange issuer.",
  "type": "object",
  "required": ["replicaCount", "image", "serviceAccount", "config", "rolloutRevisions", "workloadExchange", "service", "networkPolicy", "resources"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 2},
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "maxLength": 128, "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]*$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]},
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1, "maxLength": 253},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["issuerUrl", "githubExchangeAudience", "outputAudience", "policyConfigMapName", "keyringSecretName"],
      "properties": {
        "issuerUrl": {"type": "string", "pattern": "^https://[^/?#]+(?:/[^?#]*)?$"},
        "githubExchangeAudience": {"type": "string", "minLength": 1},
        "outputAudience": {"const": "steward-task-api"},
        "policyConfigMapName": {"type": "string", "minLength": 1},
        "policyConfigMapKey": {"type": "string", "minLength": 1},
        "keyringSecretName": {"type": "string", "minLength": 1},
        "keyringSecretKey": {"type": "string", "minLength": 1}
      }
    },
    "rolloutRevisions": {
      "type": "object",
      "required": ["githubPolicy", "githubKeyring", "workloadPolicy", "workloadRsaKeyring", "workloadTls", "browserHop1Jwks"],
      "properties": {
        "githubPolicy": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "githubKeyring": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "workloadPolicy": {"type": "string", "pattern": "^(|[a-z0-9][a-z0-9._-]{0,63})$"},
        "workloadRsaKeyring": {"type": "string", "pattern": "^(|[a-z0-9][a-z0-9._-]{0,63})$"},
        "workloadTls": {"type": "string", "pattern": "^(|[a-z0-9][a-z0-9._-]{0,63})$"},
        "browserHop1Jwks": {"type": "string", "pattern": "^(|[a-z0-9][a-z0-9._-]{0,63})$"}
      }
    },
    "workloadExchange": {
      "type": "object",
      "required": ["enabled", "outputAudience", "tls", "networkPolicy"],
      "properties": {
        "enabled": {"type": "boolean"},
        "inputAudience": {"type": "string"},
        "outputAudience": {"const": "openshell-api"},
        "policyConfigMapName": {"type": "string"},
        "policyConfigMapKey": {"type": "string", "minLength": 1},
        "rsaKeyringSecretName": {"type": "string"},
        "rsaKeyringSecretKey": {"type": "string", "minLength": 1},
        "tls": {
          "type": "object",
          "required": ["secretName", "certificateKey", "privateKeyKey"],
          "properties": {
            "secretName": {"type": "string"},
            "certificateKey": {"type": "string", "minLength": 1},
            "privateKeyKey": {"type": "string", "minLength": 1}
          }
        },
        "networkPolicy": {
          "type": "object",
          "required": ["callerNamespaceSelector", "callerPodSelector"],
          "properties": {
            "callerNamespaceSelector": {"type": "object"},
            "callerPodSelector": {"type": "object"}
          }
        }
      }
    },
    "browserHop1": {
      "type": "object",
      "required": ["enabled", "stewardJwksConfigMapKey"],
      "properties": {
        "enabled": {"type": "boolean"},
        "stewardIssuer": {"type": "string"},
        "assertionAudience": {"type": "string"},
        "outputAudience": {"type": "string"},
        "stewardJwksConfigMapName": {"type": "string"},
        "stewardJwksConfigMapKey": {"type": "string", "minLength": 1}
      }
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "port": {"const": 8080}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["minAvailable"],
      "properties": {
        "minAvailable": {"type": "integer", "minimum": 1}
      }
    },
    "serviceMonitor": {
      "type": "object",
      "required": ["enabled", "interval", "labels"],
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"},
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressCidrs"],
      "properties": {
        "enabled": {"const": true},
        "ingressCidrs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string", "minLength": 1},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "host": {"type": "string"}
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"host": {"type": "string", "minLength": 1}}}
    },
    "httpRoute": {
      "type": "object",
      "required": ["enabled", "annotations", "parentRefs", "hostnames"],
      "properties": {
        "enabled": {"type": "boolean"},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "group": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "namespace": {"type": "string", "minLength": 1},
              "sectionName": {"type": "string", "minLength": 1},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535}
            }
          }
        },
        "hostnames": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {
            "properties": {
              "parentRefs": {"minItems": 1},
              "hostnames": {"minItems": 1}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          }
        }
      },
      "then": {
        "properties": {
          "httpRoute": {
            "properties": {"enabled": {"const": false}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workloadExchange": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          }
        }
      },
      "then": {
        "properties": {
          "workloadExchange": {
            "required": ["inputAudience", "policyConfigMapName", "rsaKeyringSecretName"],
            "properties": {
              "inputAudience": {"type": "string", "minLength": 1},
              "policyConfigMapName": {"type": "string", "minLength": 1},
              "rsaKeyringSecretName": {"type": "string", "minLength": 1},
              "tls": {
                "properties": {
                  "secretName": {"type": "string", "minLength": 1}
                }
              },
              "networkPolicy": {
                "properties": {
                  "callerNamespaceSelector": {"minProperties": 1},
                  "callerPodSelector": {"minProperties": 1}
                }
              }
            }
          },
          "rolloutRevisions": {
            "properties": {
              "workloadPolicy": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
              "workloadRsaKeyring": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
              "workloadTls": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "browserHop1": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          }
        }
      },
      "then": {
        "properties": {
          "browserHop1": {
            "required": ["stewardIssuer", "assertionAudience", "outputAudience", "stewardJwksConfigMapName"],
            "properties": {
              "stewardIssuer": {"type": "string", "pattern": "^https://[^/?#]+(?:/[^?#]*)?$"},
              "assertionAudience": {"type": "string", "minLength": 1},
              "outputAudience": {"type": "string", "pattern": "^https://[^?#]+$"},
              "stewardJwksConfigMapName": {"type": "string", "minLength": 1}
            }
          },
          "workloadExchange": {
            "properties": {"enabled": {"const": true}}
          },
          "rolloutRevisions": {
            "properties": {
              "browserHop1Jwks": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
            }
          }
        }
      }
    }
  ]
}
