{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic OIDC exact-claim policy",
  "type": "object",
  "required": ["version", "providers"],
  "properties": {
    "version": {
      "const": "github-oidc-exchange.apelogic.io/oidc-policy-v1"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["issuer", "audience", "bindings"],
        "properties": {
          "issuer": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://[^/?#]+(?:/[^?#]+)?$"
          },
          "audience": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[!-~]+$"
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": ["claims", "task"],
              "properties": {
                "claims": {
                  "type": "object",
                  "required": ["sub"],
                  "minProperties": 1,
                  "maxProperties": 16,
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^.\\[\\]]+$",
                    "not": {
                      "enum": ["iss", "aud", "exp", "iat", "nbf", "jti"]
                    }
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^[!-~]+$"
                  }
                },
                "task": {
                  "type": "object",
                  "required": ["service", "owner_canonical_user_id", "owner_email"],
                  "properties": {
                    "service": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[!-~]+$"
                    },
                    "owner_canonical_user_id": {
                      "type": "string",
                      "pattern": "^usr_[0-9a-f]{32}$"
                    },
                    "owner_email": {
                      "type": "string",
                      "pattern": "^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
