{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apelogic-ai/github-oidc-exchange/blob/main/docs/policy-contract.schema.json",
  "title": "GitHub OIDC exchange policy v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "service_group",
    "acting_group_prefix",
    "bootstrap_group",
    "allowed_email_domains",
    "repositories",
    "actors"
  ],
  "properties": {
    "version": {"const": "github-oidc-exchange.apelogic.io/v3"},
    "service_group": {
      "type": "string",
      "pattern": "^agents\\.apelogic\\.ai/service-principal:.+$"
    },
    "acting_group_prefix": {"const": "agents.apelogic.ai/acting-user:"},
    "bootstrap_group": {
      "type": "string",
      "pattern": "^agents\\.apelogic\\.ai/service-envelope-bootstrap:.+$"
    },
    "allowed_email_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repository"}
    },
    "actors": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[0-9]+$"},
      "additionalProperties": {"$ref": "#/$defs/actor"}
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "owner_id",
        "repository_id",
        "subjects",
        "workflow_refs",
        "job_workflow_refs",
        "events",
        "refs"
      ],
      "properties": {
        "profile": {"enum": ["task", "bootstrap"]},
        "owner_id": {"type": "string", "pattern": "^[0-9]+$"},
        "repository_id": {"type": "string", "pattern": "^[0-9]+$"},
        "subjects": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "workflow_refs": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "job_workflow_refs": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "events": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "refs": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "canonical_user_id", "verified"],
      "properties": {
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "canonical_user_id": {
          "type": "string",
          "pattern": "^usr_[0-9a-f]{32}$"
        },
        "verified": {"const": true}
      }
    }
  }
}
